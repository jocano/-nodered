        "id": "prepare-ntfy-alert",
        "type": "function",
        "z": "55e2744a9c63c435",
        "name": "Create alert",
        "func": "const allowedDevices = [\n    \"0xa4c1385764150905\",\n    \"0xa4c1388f017f7a17\",\n    \"0xa4c13898623020ee\"\n];\n\nconst deviceId = msg.topic.split(\"/\").pop();\n\nif (!allowedDevices.includes(deviceId) || msg.payload.water_leak !== true) {\n    return null;\n}\n\nmsg.headers = {\n    Title: \"Water leak detected\",\n    Priority: \"urgent\",\n    Tags: \"warning,droplet\"\n};\n\nmsg.payload =\n    \"Water leak detected by Zigbee sensor \" +\n    deviceId +\n    \". Battery: \" +\n    msg.payload.battery +\n    \"%.\";\n\nreturn msg;",
