    {
        "id": "ca400514c8bdd2d9",
        "type": "function",
        "z": "3b0c37851869acb9",
        "name": "Alert and flash light",
        "func": "const lampTopic = \"zigbee2mqtt/0x00124b0022eaa57b/set\";\nconst deviceId = msg.topic.split(\"/\").pop();\nconst battery = msg.payload.battery;\n\nconst alert = {\n    headers: {\n        Title: \"Door open\",\n        Priority: \"urgent\",\n        Tags: \"warning,door\"\n    },\n    payload: \"Door open: contact sensor \" + deviceId + \". Battery: \" + battery + \"%.\",\n};\n\nfunction lampCommand(state) {\n    return {\n        topic: lampTopic,\n        payload: {\n            state: state\n        }\n    };\n}\n\nfor (let index = 0; index < 5; index += 1) {\n    const cycleStart = index * 4000;\n\n    setTimeout(() => {\n        node.send([null, lampCommand(\"ON\")]);\n    }, cycleStart);\n\n    setTimeout(() => {\n        node.send([null, lampCommand(\"OFF\")]);\n    }, cycleStart + 2000);\n}\n\nsetTimeout(() => {\n    node.send([null, lampCommand(\"OFF\")]);\n}, 20000);\n\nreturn [alert, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
