    {
        "id": "8b1b70291d622060",
        "type": "function",
        "z": "afae578c50c1de44",
        "name": "Store latest values and check threshold",
        "func": "let payload = msg.payload;\n\nif (typeof payload === \"string\") {\n    try {\n        payload = JSON.parse(payload);\n    } catch (error) {\n        node.error(\"Sensor payload is not valid JSON.\", msg);\n        return [null, null];\n    }\n}\n\nif (!payload || typeof payload !== \"object\") {\n    node.error(\"Sensor payload is not an object.\", msg);\n    return [null, null];\n}\n\nconst reading = flow.get(\"environmentReading\") || {};\n\nif (Number.isFinite(payload.temperature)) {\n    reading.temperature = payload.temperature;\n}\n\nif (Number.isFinite(payload.humidity)) {\n    reading.humidity = payload.humidity;\n}\n\nreading.updatedAt = new Date().toISOString();\nflow.set(\"environmentReading\", reading);\n\nconst temperatureF = reading.temperature * 9 / 5 + 32;\nconst isOverTemperature = temperatureF > 87;\nconst wasOverTemperature = flow.get(\"environmentOverTemperature\") === true;\nflow.set(\"environmentOverTemperature\", isOverTemperature);\n\nnode.status({\n    fill: isOverTemperature ? \"red\" : \"green\",\n    shape: \"dot\",\n    text: `${temperatureF.toFixed(1)} F, ${reading.humidity ?? \"?\"} %`\n});\n\n// Only activate on the transition from 50 F or below to above 90 F.\nif (isOverTemperature) {\n    return [null, {\n        topic: \"zigbee2mqtt/0xa4c138c642196a0b/set\",\n        payload: {\n            alarm: true,\n            duration: 10,\n            melody: 6,\n            volume: \"high\"\n        }\n    }];\n}\n\nreturn [null, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 120,
        "wires": [
            [],
            [
                "4c643909a96e0923",
                "b60befe6707b603d"
            ]
        ]
