    {
        "id": "e217c941931532c3",
        "type": "function",
        "z": "afae578c50c1de44",
        "name": "Build ntfy alarm",
        "func": "const reading = flow.get(\"environmentReading\");\n\nif (!reading || !Number.isFinite(reading.temperature) || !Number.isFinite(reading.humidity)) {\n    node.status({ fill: \"yellow\", shape: \"ring\", text: \"Waiting for sensor reading\" });\n    return null;\n}\n\nconst temperatureF = reading.temperature * 9 / 5 + 32;\nconst isOverTemperature = temperatureF > 50;\n\nmsg.headers = {\n    \"Title\": isOverTemperature ? \"High temperature alarm\" : \"Environment status\",\n    \"Priority\": isOverTemperature ? \"high\" : \"default\",\n    \"Tags\": isOverTemperature ? \"warning,thermometer\" : \"thermometer,droplet\"\n};\n\nmsg.payload = `Temperature: ${temperatureF.toFixed(1)} F (${reading.temperature.toFixed(1)} C)\\nHumidity: ${reading.humidity} %\\nLast sensor update: ${reading.updatedAt}`;\nnode.status({ fill: \"blue\", shape: \"dot\", text: \"Notification sent\" });\nreturn msg;",
