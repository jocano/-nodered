        "z": "4dd1dfab8396e602",
        "name": "Validate API key",
        "func": "const providedKey = msg.req.headers[\"x-api-key\"];\nconst expectedKey = env.get(\"AUTOMATION_API_KEY\");\n\nif (!expectedKey) {\n    node.error(\"AUTOMATION_API_KEY is not configured.\", msg);\n    msg.statusCode = 503;\n    msg.payload = {\n        accepted: false,\n        message: \"Automation API is not configured.\"\n    };\n    return [null, msg];\n}\n\nif (providedKey !== expectedKey) {\n    msg.statusCode = 401;\n    msg.payload = {\n        accepted: false,\n        message: \"Unauthorized.\"\n    };\n    return [null, msg];\n}\n\nreturn [msg, null];",
